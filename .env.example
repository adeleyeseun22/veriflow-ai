# Project
COMPOSE_PROJECT_NAME=veriflow
APP_NAME=VeriFlow AI API
APP_ENV=development
DEBUG=true
API_VERSION=0.4.0

# PostgreSQL
POSTGRES_DB=veriflow
POSTGRES_USER=veriflow
POSTGRES_PASSWORD=veriflow_dev_password
DATABASE_URL=postgresql+asyncpg://veriflow:veriflow_dev_password@localhost:55432/veriflow

# Redis
REDIS_URL=redis://localhost:6379/0

# Browser/API communication
BACKEND_CORS_ORIGINS=["http://localhost:3000"]
NEXT_PUBLIC_API_URL=http://localhost:8000

# Authentication
SESSION_COOKIE_NAME=veriflow_session
CSRF_COOKIE_NAME=veriflow_csrf
SESSION_TTL_SECONDS=604800
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
