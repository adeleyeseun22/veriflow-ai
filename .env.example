# Project
COMPOSE_PROJECT_NAME=veriflow
APP_NAME=VeriFlow AI API
APP_ENV=development
DEBUG=true
API_VERSION=0.1.0

# PostgreSQL — localhost values are used by local non-Docker commands
POSTGRES_DB=veriflow
POSTGRES_USER=veriflow
POSTGRES_PASSWORD=veriflow_dev_password
DATABASE_URL=postgresql+asyncpg://veriflow:veriflow_dev_password@localhost:5432/veriflow

# Redis — localhost value is used by local non-Docker commands
REDIS_URL=redis://localhost:6379/0

# Browser/API communication
BACKEND_CORS_ORIGINS=["http://localhost:3000"]
NEXT_PUBLIC_API_URL=http://localhost:8000
