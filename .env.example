COMPOSE_PROJECT_NAME=veriflow
APP_NAME=VeriFlow AI API
APP_ENV=development
DEBUG=true
API_VERSION=0.9.0

POSTGRES_DB=veriflow
POSTGRES_USER=veriflow
POSTGRES_PASSWORD=veriflow_dev_password
DATABASE_URL=postgresql+asyncpg://veriflow:veriflow_dev_password@localhost:55432/veriflow
REDIS_URL=redis://localhost:6379/0

BACKEND_CORS_ORIGINS=["http://localhost:3000"]
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_CSRF_COOKIE_NAME=veriflow_csrf

SESSION_COOKIE_NAME=veriflow_session
CSRF_COOKIE_NAME=veriflow_csrf
SESSION_TTL_SECONDS=604800
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax

MINIO_ROOT_USER=veriflow_minio
MINIO_ROOT_PASSWORD=veriflow_minio_password
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=veriflow_minio
MINIO_SECRET_KEY=veriflow_minio_password
MINIO_SECURE=false
MINIO_BUCKET=veriflow-documents
MAX_UPLOAD_SIZE_BYTES=26214400

CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_QUEUE_NAME=document-processing
PROCESSING_MAX_RETRIES=3
PROCESSING_RETRY_BASE_SECONDS=5
WORKER_HEARTBEAT_KEY=veriflow:workers:document-processing
WORKER_HEARTBEAT_TTL_SECONDS=90

PARSER_MAX_PDF_PAGES=2000
PARSER_MAX_TABLE_ROWS=5000
PARSER_MAX_TABLE_COLUMNS=256
PARSER_MAX_CELL_CHARS=10000
PARSER_MAX_SECTION_CHARS=1000000

CHUNK_MAX_CHARS=4000
CHUNK_OVERLAP_CHARS=400
CHUNK_TABLE_MAX_ROWS=40
CHUNK_TABLE_ROW_OVERLAP=2

# Vector embeddings and semantic retrieval
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32
EMBEDDING_THREADS=2
EMBEDDING_CACHE_DIR=/models/fastembed
SEMANTIC_SEARCH_DEFAULT_LIMIT=10
SEMANTIC_SEARCH_MAX_LIMIT=50
