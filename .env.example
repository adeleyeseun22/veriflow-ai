# Project
COMPOSE_PROJECT_NAME=veriflow
APP_NAME=VeriFlow AI API
APP_ENV=development
DEBUG=true
API_VERSION=0.6.0

# PostgreSQL
POSTGRES_DB=veriflow
POSTGRES_USER=veriflow
POSTGRES_PASSWORD=veriflow_dev_password
DATABASE_URL=postgresql+asyncpg://veriflow:veriflow_dev_password@localhost:55432/veriflow

# Redis and Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_QUEUE_NAME=document-processing
PROCESSING_MAX_RETRIES=3
PROCESSING_RETRY_BASE_SECONDS=5
WORKER_HEARTBEAT_KEY=veriflow:workers:document-processing
WORKER_HEARTBEAT_TTL_SECONDS=90

# MinIO object storage
MINIO_ROOT_USER=veriflow_minio
MINIO_ROOT_PASSWORD=veriflow_minio_password
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=veriflow_minio
MINIO_SECRET_KEY=veriflow_minio_password
MINIO_SECURE=false
MINIO_BUCKET=veriflow-documents
MAX_UPLOAD_SIZE_BYTES=26214400

# Browser/API communication
BACKEND_CORS_ORIGINS=["http://localhost:3000"]
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_CSRF_COOKIE_NAME=veriflow_csrf

# Authentication
SESSION_COOKIE_NAME=veriflow_session
CSRF_COOKIE_NAME=veriflow_csrf
SESSION_TTL_SECONDS=604800
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
